# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Loose documents and pictures in the top folder are never part of the
# site (its images live in public/). Added 2026-11-17 after a commit-all
# pushed "Supabase project URL.docx" — a copy of the site's secret keys —
# to the public repo. Keep notes like that outside this folder entirely.
/*.doc
/*.docx
/*.pdf
/*.xls
/*.xlsx
/*.ppt
/*.pptx
/*.pages
/*.numbers
/*.key
/*.jpg
/*.jpeg
/*.png
/*.heic
